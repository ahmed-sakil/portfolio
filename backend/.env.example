# PostgreSQL Connection String (e.g. from Neon.tech, Supabase, or Railway)
DATABASE_URL="postgresql://username:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET="your_secure_random_jwt_secret_key"

# Cloudinary Storage for Image Uploads
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
